{
  "app": {
    "name": "MyWebApp",
    "version": "2.1.0",
    "env": "production",
    "debug": false,
    "timezone": "Europe/Moscow"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "read_timeout": 30,
    "write_timeout": 30
  },
  "database": {
    "primary": {
      "driver": "postgresql",
      "host": "localhost",
      "port": 5432,
      "database": "myapp_db",
      "username": "app_user",
      "password": "${DB_PASSWORD}",
      "max_connections": 100
    }
  },
  "jwt": {
    "secret": "${JWT_SECRET}",
    "expire_hours": 24
  }
}